# ─────────────────────────────────────────────────────────────
# Enterbird — ortam değişkenleri
# Local geliştirme için bu dosyayı `.env` olarak kopyala ve doldur.
# ─────────────────────────────────────────────────────────────

# --- CMS / Payload (ZORUNLU) ---
# Auth token'larını imzalar. Prod'da MUTLAKA güçlü, rastgele bir değer olmalı.
# Üret: openssl rand -hex 32
PAYLOAD_SECRET=

# --- Veritabanı ---
# Boşsa local SQLite (cms/.payload.db) kullanılır.
# Prod'da Neon/Postgres connection string'i ver.
# DATABASE_URI=postgres://user:pass@host/db

# --- Görsel depolama (prod) ---
# Vercel Blob token'ı. Yoksa yüklenen görseller local diske yazılır.
# BLOB_READ_WRITE_TOKEN=

# --- Seed (içerik tohumlama) ---
# /api/seed endpoint'ini korur. Prod'da tanımlı değilse endpoint kapalıdır.
# Üret: openssl rand -hex 16
SEED_TOKEN=
# İlk admin kullanıcısı — seed bunu kullanır (repoda şifre tutulmaz).
SEED_ADMIN_EMAIL=admin@enterbird.com
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Enterbird Admin

# --- İletişim formu (Resend) ---
# https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Gönderen. Resend'de doğrulanmış bir domain olmalı.
# Test için: Enterbird <onboarding@resend.dev>
RESEND_FROM="Enterbird <hello@enterbird.com>"
# Form gönderimlerinin düşeceği kutu
CONTACT_TO=hello@enterbird.com
